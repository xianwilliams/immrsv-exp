# Create a free form at https://app.web3forms.com for the receiving inbox.
# This is a PUBLIC submission key, not an account API secret.
# Test with your key; replace with Nick's key and rebuild at handoff.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

SITE_URL=https://www.immrsv-exp.com
SITE_INDEXABLE=false

# Public Sanity project identifiers. Leave BOTH blank to use the local snapshot.
# Set these on the website host only when the CMS is ready to go live.
SANITY_PROJECT_ID=
SANITY_DATASET=
